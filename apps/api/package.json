{
  "name": "@workspace/api",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:client",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply todolist --local",
    "db:migrate:remote": "wrangler d1 migrations apply todolist --remote",
    "build:client": "tsup src/client.ts --format esm --dts --clean --out-dir dist"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "better-auth": "^1.7.12",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "http-status-codes": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.110.0"
  }
}
